[Unit]
Description=Hot Meme Postgres backup (pg_dump -Fc, keep 7 days)
Documentation=file:///home/ubuntu/hotmeme/deploy/README.md
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/hotmeme
# EnvironmentFile 提供 BACKUP_DATABASE_URL（缺省回退 MIGRATE_DATABASE_URL / DATABASE_URL）
EnvironmentFile=/etc/hotmeme/env
Environment=HOTMEME_BACKUP_DIR=/home/ubuntu/backups
Environment=HOTMEME_BACKUP_KEEP_DAYS=7
Environment=HOTMEME_BACKUP_LOG=/home/ubuntu/hotmeme/var/backup.log
ExecStart=/bin/bash /home/ubuntu/hotmeme/deploy/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=900
NoNewPrivileges=true
PrivateTmp=true
