[Unit]
Description=Hot Meme Report Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/hotmeme
Environment=MEME_INFO_WORKER_INTERVAL=600
Environment=MEME_INFO_REPORT=/home/ubuntu/hotmeme/var/meme_info_latest.json
Environment=MEME_INFO_CACHE_DIR=/home/ubuntu/hotmeme/var/cache
Environment=MEME_INFO_WORKER_LOG=/home/ubuntu/hotmeme/var/worker.log
Environment=HOTMEME_LLM_API_KEY_FILE=/home/ubuntu/.hotmeme_llm_key
ExecStart=/bin/bash tools/meme_info_worker.sh
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
